# --- Azure AI Foundry project (hosts the adversarial simulator + evaluators) ---
# Must be in a supported region: East US 2, France Central, Sweden Central,
# Switzerland West, or North Central US.
AZURE_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# --- Copilot Studio target agent ---
# From Entra ID app registration:
TENANT_ID=<tenant-guid>
APP_CLIENT_ID=<app-registration-client-guid>
# From Copilot Studio > Settings > Advanced > Metadata:
ENVIRONMENT_ID=<environment-guid>
AGENT_IDENTIFIER=xy0z_YourAgentName

# --- Report metadata (optional) ---
TARGET_ENVIRONMENT=Test
