    },
    {
      "id": "quick-smoke",
      "enabled": false,
      "description": "Fast baseline-only smoke test on the four core content risks.",
      "riskCategories": [
        "Violence",
        "HateUnfairness",
        "Sexual",
        "SelfHarm"
      ],
      "attackStrategies": [
        "BASELINE"
      ],
