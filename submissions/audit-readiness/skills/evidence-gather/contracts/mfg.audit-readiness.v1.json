{ "$schema": "http://json-schema.org/draft-07/schema#", "$id": "mfg.audit-readiness.v1",
  "title": "Audit Readiness contract v1",
  "description": "Chains scope-map -> evidence-gather -> gap-check (Govern) -> readiness-pack. Data + confidence + provenance + citations on every hop.",
  "type": "object", "required": ["contract_version", "audit_id", "scope"],
  "properties": {
    "contract_version": { "const": "mfg.audit-readiness.v1" },
    "audit_id": { "type": "string" }, "standard": { "type": "string" },
    "audit_date": { "type": "string" }, "scope": { "type": "array", "items": { "type": "string" } },
    "clause_map": { "type": "array", "items": { "type": "object",
      "required": ["clause", "title", "required_evidence", "source", "citation"],
      "properties": { "clause": {"type": "string"}, "title": {"type": "string"},
        "required_evidence": {"type": "array", "items": {"type": "string"}},
        "max_age_days": {"type": "integer"}, "criticality": {"enum": ["major", "minor"]},
        "source": {"type": "string"}, "citation": {"type": "string"} } } },
    "gaps": { "type": "array", "items": { "type": "object",
      "required": ["clause", "status", "severity", "source", "citation"],
      "properties": { "clause": {"type": "string"}, "status": {"enum": ["present", "partial", "missing", "stale"]},
        "severity": {"enum": ["major", "minor", "none"]}, "detail": {"type": "string"},
        "owner": {"type": "string"}, "action": {"type": "string"},
        "source": {"type": "string"}, "citation": {"type": "string"} } } },
    "readiness": { "type": "object" },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" } } }
