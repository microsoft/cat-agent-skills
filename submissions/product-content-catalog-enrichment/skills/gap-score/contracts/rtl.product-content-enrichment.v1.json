{ "$schema": "http://json-schema.org/draft-07/schema#", "$id": "rtl.product-content-enrichment.v1",
  "title": "Product Content & Catalog Enrichment contract v1",
  "description": "Chains source-ingest -> attribute-normalize -> gap-score -> claim-check (Govern) -> content-draft. Data + confidence + provenance + citations on every hop.",
  "type": "object", "required": ["contract_version", "batch_id", "skus"],
  "properties": {
    "contract_version": { "const": "rtl.product-content-enrichment.v1" },
    "batch_id": { "type": "string" }, "supplier": { "type": "string" }, "channel": { "type": "string" },
    "skus": { "type": "array", "items": { "type": "object" } },
    "normalized": { "type": "array", "items": { "type": "object",
      "required": ["gtin", "gtin_valid", "attributes", "unmapped", "source", "citation"],
      "properties": { "gtin": {"type": "string"}, "gtin_valid": {"type": "boolean"},
        "attributes": {"type": "object"}, "unmapped": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"}, "citation": {"type": "string"} } } },
    "completeness": { "type": "array", "items": { "type": "object" } },
    "claim_findings": { "type": "array", "items": { "type": "object",
      "required": ["gtin", "claim", "verdict", "source", "citation"],
      "properties": { "gtin": {"type": "string"}, "claim": {"type": "string"},
        "verdict": {"enum": ["approved", "unapproved", "regulated_blocked"]},
        "detail": {"type": "string"}, "source": {"type": "string"}, "citation": {"type": "string"} } } },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" } } }
