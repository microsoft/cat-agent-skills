{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mfg.quality-inspection.v1",
  "title": "Quality Inspection contract v1",
  "description": "Versioned contract chaining spec-ingest -> tolerance-check -> defect-grade -> ncr-draft. Carries data + confidence + provenance + citations on every hop so escalation is mechanical. Bump the version only on breaking schema changes (additive fields are non-breaking).",
  "type": "object",
  "required": ["contract_version", "part_number", "lot_id", "characteristics"],
  "properties": {
    "contract_version": { "const": "mfg.quality-inspection.v1" },
    "part_number": { "type": "string" },
    "part_revision": { "type": "string" },
    "lot_id": { "type": "string" },
    "lot_quantity": { "type": "integer", "minimum": 1 },
    "sample_size": { "type": "integer", "minimum": 1 },
    "coc": {
      "type": "object",
      "properties": {
        "doc_id": { "type": "string" },
        "supplier": { "type": "string" },
        "claims": { "type": "array", "items": { "type": "object",
          "required": ["characteristics", "claim", "citation"],
          "properties": {
            "characteristics": { "type": "array", "items": { "type": "string" } },
            "claim": { "type": "string" },
            "citation": { "type": "string" } } } }
      }
    },
    "characteristics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "actual", "status", "confidence", "source", "citation"],
        "properties": {
          "name": { "type": "string" },
          "unit": { "type": "string" },
          "nominal": { "type": ["number", "null"] },
          "lower_tolerance": { "type": ["number", "null"] },
          "upper_tolerance": { "type": ["number", "null"] },
          "criticality": { "enum": ["critical", "major", "minor"] },
          "criticality_source": { "type": "string", "description": "where the criticality comes from, e.g. 'drawing note 9 (fatigue-critical surface)'" },
          "rework_permitted": { "type": "boolean" },
          "actual": { "type": "number", "description": "worst-case measured value (max band consumption)" },
          "stats": { "type": "object", "properties": {
            "n": { "type": "integer" }, "mean": { "type": "number" },
            "min": { "type": "number" }, "max": { "type": "number" },
            "band_consumed_pct": { "type": "number" } } },
          "n_out_of_tolerance": { "type": "integer" },
          "incidence_pct": { "type": "number" },
          "doc_conflict": { "type": "boolean", "description": "true when a CoC claim covers this characteristic but measurements disagree (disposition-rules.md #4.3)" },
          "status": { "enum": ["in_tolerance", "in_tolerance_marginal", "out_of_tolerance", "not_evaluated"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string", "pattern": "^(engine|skill|connector):" },
          "citation": { "type": "string" }
        }
      }
    },
    "graded_defects": {
      "type": "array",
      "items": { "type": "object",
        "required": ["characteristic", "severity", "disposition", "confidence", "source", "citation"],
        "properties": {
          "characteristic": { "type": "string" },
          "severity": { "enum": ["critical", "major", "minor"] },
          "disposition": { "enum": ["use_as_is", "rework", "scrap", "return_to_vendor", "hold_for_review"] },
          "rationale": { "type": "string" },
          "requires_deviation_authorization": { "type": "boolean" },
          "confidence": { "type": "number" },
          "source": { "type": "string" },
          "citation": { "type": "string" } } }
    },
    "watch_list": { "type": "array", "items": { "type": "object", "properties": {
      "characteristic": { "type": "string" }, "note": { "type": "string" }, "citation": { "type": "string" } } } },
    "recommended_disposition": { "enum": ["accept", "use_as_is", "rework", "scrap", "return_to_vendor", "hold_for_review"] },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object", "properties": {
      "engines": { "type": "array", "items": { "type": "string" } },
      "generated_at": { "type": "string" }, "demo_scenario": { "type": "string" } } }
  }
}
