{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inspection input specification",
  "type": "object",
  "required": [
    "part_number",
    "part_revision",
    "lot_id",
    "lot_quantity",
    "characteristics"
  ],
  "properties": {
    "part_number": {
      "type": "string",
      "minLength": 1
    },
    "part_revision": {
      "type": "string",
      "minLength": 1
    },
    "lot_id": {
      "type": "string",
      "minLength": 1
    },
    "lot_quantity": {
      "type": "integer",
      "minimum": 1
    },
    "characteristics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "citation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "lsl": {
            "type": [
              "number",
              "null"
            ]
          },
          "usl": {
            "type": [
              "number",
              "null"
            ]
          },
          "nominal": {
            "type": [
              "number",
              "null"
            ]
          },
          "criticality": {
            "enum": [
              "critical",
              "major",
              "minor",
              null
            ]
          },
          "rework_permitted": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "tolerance_kind": {
            "enum": [
              "two_sided",
              "upper_limit_only",
              "lower_limit_only"
            ]
          }
        }
      }
    }
  }
}