<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://example.com/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Customer Onboarding" processRef="Process_1" />
    <bpmn:participant id="Participant_2" name="Applicant" />
    <bpmn:messageFlow id="Flow_Msg" sourceRef="Participant_2" targetRef="Activity_Capture" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Intake" name="Onboarding Team">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Existing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AML</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_LinkThrow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_LinkCatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Record</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance" name="Compliance Team">
        <bpmn:flowNodeRef>Activity_KYC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_MoreInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Application received"><bpmn:outgoing>Flow_01</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Activity_Capture" name="Capture application"><bpmn:incoming>Flow_01</bpmn:incoming><bpmn:outgoing>Flow_02</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Existing" name="Existing account?"><bpmn:incoming>Flow_02</bpmn:incoming><bpmn:outgoing>Flow_03</bpmn:outgoing><bpmn:outgoing>Flow_04</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_Verify" name="Verify existing details"><bpmn:incoming>Flow_03</bpmn:incoming><bpmn:outgoing>Flow_05</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Activity_Open" name="Open new account"><bpmn:incoming>Flow_04</bpmn:incoming><bpmn:outgoing>Flow_06</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge"><bpmn:incoming>Flow_05</bpmn:incoming><bpmn:incoming>Flow_06</bpmn:incoming><bpmn:outgoing>Flow_07</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Fork"><bpmn:incoming>Flow_07</bpmn:incoming><bpmn:outgoing>Flow_08</bpmn:outgoing><bpmn:outgoing>Flow_09</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="Activity_KYC" name="KYC check"><bpmn:incoming>Flow_08</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Pass" name="KYC passed?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_MoreInfo" name="Request more information"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Activity_AML" name="AML screening"><bpmn:incoming>Flow_09</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_LinkThrow" name="Link A"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:linkEventDefinition id="LED_Event_LinkThrow" name="Link A" /></bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Event_LinkCatch" name="Link A"><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:linkEventDefinition id="LED_Event_LinkCatch" name="Link A" /></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_Record" name="Record screening result"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Credit" name="Credit check"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="Activity_Approve" name="Approve and notify"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1" name="Onboarding complete"><bpmn:incoming>Flow_20</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Activity_Capture" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Activity_Capture" targetRef="Gateway_Existing" />
    <bpmn:sequenceFlow id="Flow_03" name="Yes" sourceRef="Gateway_Existing" targetRef="Activity_Verify" />
    <bpmn:sequenceFlow id="Flow_04" name="No" sourceRef="Gateway_Existing" targetRef="Activity_Open" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Activity_Verify" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Activity_Open" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_Merge" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_Fork" targetRef="Activity_KYC" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Fork" targetRef="Activity_AML" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_Fork" targetRef="Activity_Credit" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_KYC" targetRef="Gateway_Pass" />
    <bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="Gateway_Pass" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="Gateway_Pass" targetRef="Activity_MoreInfo" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Activity_MoreInfo" targetRef="Activity_KYC" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Activity_AML" targetRef="Event_LinkThrow" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Event_LinkCatch" targetRef="Activity_Record" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Activity_Record" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Activity_Credit" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Gateway_Join" targetRef="Activity_Approve" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_Approve" targetRef="EndEvent_1" />
    <bpmn:textAnnotation id="TextAnnotation_1"><bpmn:text>Description: Screens the applicant against sanctions and PEP lists. Owner: Compliance Operations</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Activity_AML" targetRef="TextAnnotation_1" />
  </bpmn:process>
