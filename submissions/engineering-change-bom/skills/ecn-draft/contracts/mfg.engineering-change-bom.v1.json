{ "$schema": "http://json-schema.org/draft-07/schema#", "$id": "mfg.engineering-change-bom.v1",
  "title": "Engineering Change & BOM contract v1",
  "description": "Chains ecr-ingest -> bom-impact (where_used + bom_impact engines) -> standards-check -> ecn-draft. Data + confidence + provenance + citations on every hop.",
  "type": "object", "required": ["contract_version", "ecr_id", "part_number"],
  "properties": {
    "contract_version": { "const": "mfg.engineering-change-bom.v1" },
    "ecr_id": { "type": "string" }, "part_number": { "type": "string" },
    "change_type": { "enum": ["dimension_change", "tolerance_relax", "tolerance_tighten", "material_change", "finish_change", "note_change"] },
    "change_description": { "type": "string" },
    "affected_characteristic": { "type": "string" },
    "where_used": { "type": "array", "items": { "type": "object",
      "required": ["parent", "level", "source", "citation"],
      "properties": { "parent": {"type": "string"}, "level": {"type": "integer"}, "qty_per": {"type": "number"},
        "interface_critical": {"type": "boolean"}, "source": {"type": "string"}, "citation": {"type": "string"} } } },
    "impact": { "type": "object", "properties": {
        "impact_class": { "enum": ["form", "fit", "function"] },
        "interface_violation": { "type": "boolean" },
        "affected_items": { "type": "array", "items": { "type": "object" } },
        "documents_to_update": { "type": "array", "items": { "type": "object" } },
        "inventory_disposition": { "type": "object" },
        "confidence": { "type": "number" }, "source": { "type": "string" }, "citation": { "type": "string" } } },
    "standards_findings": { "type": "array", "items": { "type": "object" } },
    "escalations": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object" } } }
