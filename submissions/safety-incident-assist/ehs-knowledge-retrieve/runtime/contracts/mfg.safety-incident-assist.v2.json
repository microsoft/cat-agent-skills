  "required": [
    "contract_version",
    "incident_id",
    "asset_or_area"
  ],
  "properties": {
    "contract_version": {
      "const": "mfg.safety-incident-assist.v2",
      "type": "string"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "report_channel": {
      "enum": [
        "form",
        "email",
        "voice"
      ]
    },
    "incident_type": {
      "enum": [
        "injury",
        "illness",
        "near_miss",
        "property",
        "environmental"
      ]
    },
    "asset_or_area": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "reported_by": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "injury": {
      "type": "object",
      "description": "Injury/illness detail used by the recordability engine (osha-recordability-rules.md).",
      "properties": {
        "employee": {
          "type": "string"
        },
        "body_part": {
          "type": "string"
        },
        "nature": {
          "type": "string",
          "description": "e.g. laceration, fracture, crush, strain, burn"
        },
        "treatment_given": {
          "enum": [
            "none",
            "first_aid",
            "medical_treatment",
            "hospitalization",
            null
          ]
        },
        "outcome": {
          "enum": [
            "none",
            "days_away",
            "restricted_duty",
            "job_transfer",
            "in_patient_hospitalization",
            "amputation",
            "loss_of_eye",
            "fatality",
            null
          ]
        },
        "days_away": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Exact supplied integer only, 0..2^53-1 portable transport bound, NOT an OSHA cap. Qualitative counts remain null with cited wording."
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "loss_of_consciousness": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "significant_diagnosis": {
          "enum": [
            "none",
            "fracture",
            "cracked_bone",
            "punctured_eardrum",
            "cancer",
            "chronic_irreversible_disease",
            "other",
            "unknown",
            null
          ]
        },
        "diagnosed_by": {
          "enum": [
            "physician_or_plhcp",
            "unknown",
            null
          ]
        },
        "diagnosis_citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "other_recording_criteria_reviewed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "absence_confirmed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Explicit cited absence of injury/illness, never inferred from missing fields."
        },
        "days_away_evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Preserved qualitative or conflicting estimate; never coerced to an exact integer."
        }
      },
      "additionalProperties": false
