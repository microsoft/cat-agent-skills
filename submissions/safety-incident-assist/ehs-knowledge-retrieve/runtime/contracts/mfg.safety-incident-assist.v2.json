{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mfg.safety-incident-assist.v2",
  "title": "Safety Incident Assist v2 draft candidate contract",
  "description": "rc.3 draft-only prerelease: rc.2 fields retained; exact integer transport bound and optional cited source_conflicts added. No automatic migration. NOT FOR OPERATIONAL USE.",
