        },
        "provenance": {
          "required": [
            "engines",
            "generated_at"
          ],
          "properties": {
            "engines": {
              "minItems": 3,
              "prefixItems": [
                {
                  "pattern": "^scope_digest/"
                },
                {
                  "pattern": "^knowledge_match/"
                },
                {
                  "pattern": "^wall_check/"
                }
              ]
            }
          }
        }
      }
    },
    "stage_access": {
      "description": "access-checklist.json as written by access_checklist (the pack-draft input).",
      "allOf": [
