            "minimum_detail",
            "required_elements_missing",
            "block_billing",
            "prohibited_term",
            "vague_phrase",
            "embedded_instruction",
            "code_mapping_mismatch",
            "non_billable_activity",
            "rounding_increment",
            "date_mismatch",
            "no_linked_evidence",
            "evidence_overrun",
            "cross_person_link",
            "unmapped_code",
            "submitted_code_mismatch",
            "duplicate_meeting",
            "confidence_floor"
          ]
        },
        "severity": {
          "enum": [
            "needs_review",
            "hold_for_review",
            "reject"
          ]
        },
        "detail": {
          "$ref": "#/definitions/text"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        },
        "citations": {
          "$ref": "#/definitions/strings"
        },
        "source": {
          "$ref": "#/definitions/source"
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/flag"
      }
    },
    "dates_or_null": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/date"
      },
      "description": "[first, last] ISO dates, or null when there are none"
    }
  },
