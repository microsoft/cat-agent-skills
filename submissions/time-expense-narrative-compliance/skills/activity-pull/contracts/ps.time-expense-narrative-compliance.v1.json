{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ps.time-expense-narrative-compliance.v1",
  "title": "Time & Expense Narrative Compliance contract v1",
  "description": "Chains activity-pull -> narrative-draft -> code-map -> guideline-check (Govern) -> exception-report. Every hop carries data, confidence, provenance and citations. Existing narratives stay unchanged while optional suggested_rewrites are separately labeled; compliance flags may include no_linked_evidence and recommended_task_code may be BH910; purpose may be null; optional organizer, attendees, deliverable, excluded_activity_ids and provenance.excluded_signals / signal_policy record signal-privacy exclusions (client-billing-guidelines.md #10.1). v1.0.4 adds optional engagement.engagement_manager, provenance.timekeeper_scope (requester, mode self|team, engagement-manager team_view confirmation, withheld rows; client-billing-guidelines.md #12.1) and provenance.period_check, draft.covered_activity_ids, and embedded_instruction markers on signals, entries and missing-time items; flagged text is withheld from drafts, rewrites and missing-time listings (#11.1, #11.2). Every engine validates every field it reads (signal_policy.validate_packet): a wrong JSON type, a missing required field or an unrecognised enum value is an input error with no output, never coerced. Engine results are never taken on trust (client-billing-guidelines.md #13): guideline_check recomputes every code_mapping and holds an entry whose supplied mapping disagrees (code_mapping_mismatch; the recomputed mapping is written with supplied_mapping_rejected: true), and exception_report re-runs the guideline rules and refuses governed data whose verdicts, flags, missing-time items or summary figures are understated or contradict the line items. This schema is enforced in full: every engine walks it (contract_check.py, shipped byte-identically with each engine) over every input - required fields, JSON types, closed enums, patterns, nested objects and arrays - and a violation is an input error with no output. Engagement identity is fixed by activity_pull in the required provenance.engagement_identity (client-billing-guidelines.md #13.3): every later engine refuses a packet whose engagement header differs from it, so packets written before 1.0.4 must be re-run from activity_pull. A signal or time entry whose source (connector:<name>:<engagement>) or engagement_id names another engagement is excluded (provenance.excluded_signals, provenance.excluded_entries) and never rendered. Exclusion reasons and citations are printed only in the engines' own wording, and draft and rewrite review reasons are screened as free text (#13.2).",
  "type": "object",
  "required": [
    "contract_version",
    "engagement",
    "period",
    "activity_signals",
    "time_entries",
    "provenance",
    "signal_config",
    "code_structure",
    "guidelines"
  ],
  "definitions": {
    "text": {
      "type": "string"
    },
    "text_or_null": {
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "\\S",
      "description": "A non-empty identifier."
    },
    "record_id": {
      "type": "string",
      "format": "record-id",
      "description": "A record ID (client-billing-guidelines.md #13.9): 1 to 64 ASCII letters or digits in segments joined by single - _ or . separators. An ID is a key, never prose: no space, punctuation or other character."
    },
    "record_id_or_null": {
      "type": [
        "string",
        "null"
      ],
      "format": "record-id",
      "description": "A record ID (client-billing-guidelines.md #13.9): 1 to 64 ASCII letters or digits in segments joined by single - _ or . separators. An ID is a key, never prose: no space, punctuation or other character. Null when absent."
    },
    "record_id_or_withheld": {
      "type": "string",
      "format": "record-id-or-withheld",
      "description": "A record ID (client-billing-guidelines.md #13.9): 1 to 64 ASCII letters or digits in segments joined by single - _ or . separators. An ID is a key, never prose: no space, punctuation or other character. An excluded ID that the engines screened out is the exact withheld marker (#11.3)."
    },
    "record_ids": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record_id"
      }
    },
    "record_ids_or_withheld": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/record_id_or_withheld"
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "withheld_fields": {
      "type": "array",
      "description": "Placeholder ledger (client-billing-guidelines.md #11.4): the exact relative path of every withheld marker in this record, written by the engine that placed it. A marker without its own ledger path, or a path without its marker, is refused.",
      "items": {
        "type": "string",
        "pattern": "^(?:/(?:[a-z_]{1,40}|[0-9]+|@member[0-9]+|@key[0-9a-f]{16}))+$"
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "YYYY-MM-DD; a real calendar date (format is enforced at every stage).",
      "format": "date"
    },
    "date_or_null": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "date_or_multiple": {
      "type": "string",
      "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2}|multiple)$",
      "format": "date-or-multiple",
      "description": "A real YYYY-MM-DD date, or 'multiple' for a rolled-up missing-time exception."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "format": "date-time",
      "description": "ISO-8601 date-time with seconds and an offset, as the engines write it; a real instant, checked at every stage."
    },
    "hours": {
      "type": "number",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "string",
      "pattern": "^(engine|skill|connector):",
      "description": "Origin label. A third ':'-separated segment is an engagement scope: a signal or time entry whose scope names another engagement is excluded (client-billing-guidelines.md #13.3). A self-declared source is never proof of origin (#13.2)."
    },
    "engine": {
      "type": "string",
      "pattern": "^engine:[a-z_]+$"
    },
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/definitions/date_or_null"
        },
        "end": {
          "$ref": "#/definitions/date_or_null"
        }
      }
    },
    "flag": {
      "type": "object",
      "required": [
