---
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const skills = await getCollection("skills");
  const tags = new Set<string>();
  for (const skill of skills) for (const t of skill.data.tags) tags.add(t);

  return [...tags].map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

interface Props {
  tag: string;
}

const { tag } = Astro.props;
return Astro.redirect(withBase(`/?tag=${encodeURIComponent(tag)}`), 301);
---
