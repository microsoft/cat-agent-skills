---
import type { CollectionEntry } from "astro:content";
import SubmissionItem from "./SubmissionItem.astro";

interface Props {
  id: string;
  title: string;
  submissions: CollectionEntry<"skills">[];
}
const { id, title, submissions } = Astro.props;
---

<section id={id} class="submission-carousel mx-auto max-w-8xl px-4 pt-5 sm:px-6" aria-labelledby={`${id}-heading`} aria-roledescription="carousel">
  <div class="carousel-header mb-3 flex items-center justify-between gap-4">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
      <h2 id={`${id}-heading`} class="text-xl font-bold tracking-tight text-fg sm:text-2xl">
        {title} <span data-carousel-count hidden={submissions.length === 0} class="text-base font-normal text-muted">({submissions.length})</span>
      </h2>
      <span data-carousel-empty-label hidden={submissions.length > 0} class="text-sm text-muted">No matches for this selection</span>
    </div>
    <div data-carousel-controls class="hidden shrink-0 items-center gap-2">
      <button type="button" data-carousel-prev aria-label={`Previous ${title} submissions`} aria-controls={`${id}-track`} class="carousel-arrow" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
      </button>
      <button type="button" data-carousel-next aria-label={`Next ${title} submissions`} aria-controls={`${id}-track`} class="carousel-arrow" disabled>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-5 w-5" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
      </button>
    </div>
  </div>
  <div id={`${id}-track`} data-carousel-track class="carousel-track" hidden={submissions.length === 0} tabindex="0" aria-label={`${title} submissions`}>
    {submissions.map((submission) => <SubmissionItem submission={submission} variant="spotlight" />)}
  </div>
  <p data-carousel-status class="sr-only" role="status" aria-live="polite"></p>
  <div data-carousel-empty class="carousel-empty" hidden={submissions.length > 0}>
    <div class="carousel-skeletons" aria-hidden="true">
      {[0, 1, 2, 3].map(() => (
        <div class="skeleton-card">
          <div class="flex items-start gap-2.5">
            <div class="skeleton-bar h-8 w-8 shrink-0 rounded-lg"></div>
            <div class="flex-1 space-y-2 pt-1">
              <div class="skeleton-bar h-4 w-4/5"></div>
              <div class="skeleton-bar h-4 w-3/5"></div>
              <div class="skeleton-bar h-2.5 w-1/3"></div>
            </div>
          </div>
          <div class="mt-4 space-y-3">
            <div class="skeleton-bar h-2.5 w-full"></div>
            <div class="skeleton-bar h-2.5 w-11/12"></div>
          </div>
          <div class="mt-auto flex justify-between gap-2 pt-3">
            <div class="skeleton-bar h-2.5 w-20"></div>
            <div class="skeleton-bar h-2.5 w-16"></div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .submission-carousel {
    /* Keep disappearing carousel cards from becoming the page's scroll anchor. */
    overflow-anchor: none;
  }
  .carousel-header {
    min-height: var(--carousel-header-height, 2.75rem);
  }
  .carousel-track,
  .carousel-empty {
    min-height: var(--carousel-track-height, 11.75rem);
    padding: 0.25rem 0.25rem 1rem;
    margin: -0.25rem;
  }
  .carousel-empty {
    display: grid;
  }
  .carousel-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(20rem, 88%);
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding: 0.25rem;
  }
  .carousel-track :global(.submission-item) {
    min-width: 0;
    scroll-snap-align: start;
  }
  .carousel-skeletons {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(20rem, 88%);
    gap: 1rem;
    overflow: hidden;
    mask-image: linear-gradient(to right, black 65%, transparent);
  }
  .skeleton-card {
    display: flex;
    min-height: 10.5rem;
    flex-direction: column;
    padding: 0.875rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--surface);
  }
  .skeleton-bar {
    border-radius: 0.25rem;
    background: var(--border);
    opacity: 0.55;
  }
  .carousel-arrow {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--fg);
    background: var(--surface);
    cursor: pointer;
  }
  .carousel-arrow:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent-text);
  }
  .carousel-arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }
  :is(.carousel-track, .carousel-arrow):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
