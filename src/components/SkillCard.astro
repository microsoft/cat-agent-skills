---
import { withBase } from "../lib/url";
import { coverGradient, initials } from "../lib/skills";
import type { Platform, SkillType } from "../lib/skills";
import { CATEGORY_COLORS, CATEGORY_LABELS, type Category } from "../lib/categories";
import CategoryIcon from "./CategoryIcon.astro";

interface Props {
  slug: string;
  name: string;
  description: string;
  platforms?: Platform[];
  type?: SkillType;
  category?: Category;
  builtByMicrosoft?: boolean;
  variant?: "gallery" | "spotlight";
  tags?: string[];
  coverColor?: string;
  featured?: boolean;
}

const {
  slug,
  name,
  description,
  platforms = [],
  type = "skill",
  category = "productivity",
  builtByMicrosoft = false,
  variant = "gallery",
  tags = [],
  coverColor,
  featured = false,
} = Astro.props;

const gradient = coverGradient(slug, coverColor);
const mark = initials(name);
const isSample = tags.includes("sample");
const isInteractive = !isSample;
const wrapperClass = isSample
  ? "group flex h-full cursor-not-allowed select-none flex-col rounded-xl border border-border bg-surface p-4 opacity-55 saturate-50"
  : "group flex h-full flex-col rounded-xl border border-border bg-surface p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md";
const Wrapper = isInteractive ? "a" : "div";
const wrapperProps = isInteractive
  ? { href: withBase(`/skills/${slug}`) }
  : { "aria-disabled": "true", title: "Sample / demo skill — placeholder content, not accessible" };
---

<Wrapper
  class:list={["submission-card", wrapperClass]}
  data-variant={variant}
  style={builtByMicrosoft ? `--category-color:${CATEGORY_COLORS[category]}` : undefined}
  {...wrapperProps}
>
  {variant === "spotlight" ? (
    <>
      <div class="spotlight-heading flex items-start gap-2.5">
        <span class="category-icon grid h-8 w-8 shrink-0 place-items-center rounded-lg text-white" aria-hidden="true">
          <CategoryIcon category={category} />
        </span>
        <h3 class="submission-title line-clamp-2 min-w-0 font-semibold text-fg" title={name}>{name}</h3>
      </div>
      <p class="submission-description mt-2 line-clamp-2 text-sm leading-relaxed text-muted">{description}</p>
    </>
  ) : (
    <>
  <div class="gallery-heading flex items-start gap-3">
    <div class="relative shrink-0">
      <span
        class:list={[
          "submission-monogram grid h-9 w-9 place-items-center rounded-lg text-xs font-bold",
          builtByMicrosoft ? "category-icon text-white" : "text-white shadow-sm",
        ]}
        style={builtByMicrosoft ? undefined : `background-image:${gradient}`}
        aria-hidden="true"
      >
        {builtByMicrosoft ? <CategoryIcon category={category} /> : mark}
      </span>
      {
        featured && !builtByMicrosoft && (
          <span
            class="absolute -right-1.5 -top-1.5 grid h-[18px] w-[18px] place-items-center rounded-full bg-white text-amber-500 shadow ring-1 ring-black/5"
            title="Hand-picked featured skill"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-2.5 w-2.5">
              <path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94L12 2.5z" />
            </svg>
          </span>
        )
      }
    </div>
    <h3
      class="submission-title line-clamp-2 min-w-0 font-semibold text-fg transition-colors group-hover:text-accent-text"
      title={name}
    >
      {name}
    </h3>
  </div>

  <p class="submission-description mt-3 line-clamp-2 text-sm text-muted">{description}</p>
    </>
  )}
  <div class:list={[
    "submission-meta mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-[11px] leading-4 text-muted",
    variant === "spotlight" ? "pt-3" : "gallery-meta pt-4",
  ]}>
    {variant === "spotlight" && <span>{CATEGORY_LABELS[category]}</span>}
    {variant === "gallery" && builtByMicrosoft && <span>Built by Microsoft</span>}
    <span class="submission-format-platform ml-auto flex flex-wrap items-center justify-end gap-x-1.5">
      <span class="capitalize">{isSample ? "Sample" : type}</span>
      {platforms.map((platform) => <><span aria-hidden="true">&middot;</span><span class="whitespace-nowrap">{platform}</span></>)}
    </span>
  </div>
</Wrapper>

<style>
  .submission-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .category-icon {
    background: linear-gradient(135deg, color-mix(in srgb, var(--category-color) 70%, white), var(--category-color));
  }
  .submission-card[data-variant="gallery"] { min-height: 12rem; }
  [data-variant="gallery"] .gallery-heading { min-height: 2.6rem; }
  [data-variant="gallery"] .submission-title { font-size: 1rem; line-height: 1.3; }
  [data-variant="gallery"] .submission-description { min-height: 2.625rem; line-height: 1.5; }
  .submission-card[data-variant="spotlight"] {
    min-height: 10.5rem;
    padding: 0.875rem;
    border-radius: 0.75rem;
    border-color: var(--border);
    background: var(--surface);
  }
  .submission-card[data-variant="spotlight"]:where(a:hover) {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--surface));
  }
  [data-variant="spotlight"] .spotlight-heading {
    min-height: 2.6rem;
  }
  [data-variant="spotlight"] .submission-title {
    width: 100%;
    font-size: 1rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    -webkit-line-clamp: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .submission-card {
      transition: none;
      transform: none;
    }
  }
</style>
