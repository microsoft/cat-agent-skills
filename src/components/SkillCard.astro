---
import { withBase } from "../lib/url";
import { coverGradient, initials, PLATFORM_COLORS } from "../lib/skills";
import type { Platform, SkillType } from "../lib/skills";
import { CATEGORY_LABELS, type Category } from "../lib/categories";

interface Props {
  slug: string;
  name: string;
  description: string;
  platforms?: Platform[];
  type?: SkillType;
  category?: Category;
  builtByMicrosoft?: boolean;
  variant?: "gallery" | "spotlight";
  tags?: string[];
  author?: string;
  coverColor?: string;
  hasBundle?: boolean;
  /** True when an automation ships as an installer `.zip` (vs an importable `.json`). */
  isInstaller?: boolean;
  rating?: number;
  downloads?: number;
  featured?: boolean;
}

const {
  slug,
  name,
  description,
  platforms = [],
  type = "skill",
  category = "productivity",
  builtByMicrosoft = false,
  variant = "gallery",
  tags = [],
  author,
  coverColor,
  hasBundle = false,
  isInstaller = false,
  rating = 0,
  downloads = 0,
  featured = false,
} = Astro.props;

const gradient = coverGradient(slug, coverColor);
const mark = initials(name);
const isSample = tags.includes("sample");
const isPlugin = type === "plugin";
const isAutomation = type === "automation";
const shownTags = tags.filter((t) => t !== "sample").slice(0, 3);
const isInteractive = !isSample;
const wrapperClass = isSample
  ? "group flex h-full cursor-not-allowed select-none flex-col rounded-xl border border-border bg-surface p-4 opacity-55 saturate-50"
  : "group flex h-full flex-col rounded-xl border border-border bg-surface p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md";
const Wrapper = isInteractive ? "a" : "div";
const wrapperProps = isInteractive
  ? { href: withBase(`/skills/${slug}`) }
  : { "aria-disabled": "true", title: "Sample / demo skill — placeholder content, not accessible" };
---

<Wrapper class:list={["submission-card", wrapperClass]} data-variant={variant} {...wrapperProps}>
  <div class="mb-3 flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-[11px] font-medium text-muted">
    <span>{CATEGORY_LABELS[category]}</span>
    {builtByMicrosoft && <span class="text-accent-text">Built by Microsoft</span>}
  </div>
  <!-- Header: monogram + name + platforms -->
  <div class="flex items-start gap-3">
    <div class="relative shrink-0">
      <span
        class="submission-monogram grid h-11 w-11 place-items-center rounded-lg text-sm font-bold text-white shadow-sm"
        style={`background-image:${gradient}`}
        aria-hidden="true"
      >
        {mark}
      </span>
      {
        featured && !builtByMicrosoft && (
          <span
            class="absolute -right-1.5 -top-1.5 grid h-[18px] w-[18px] place-items-center rounded-full bg-white text-amber-500 shadow ring-1 ring-black/5"
            title="Hand-picked featured skill"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-2.5 w-2.5">
              <path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94L12 2.5z" />
            </svg>
          </span>
        )
      }
    </div>
    <div class="min-w-0 flex-1">
      <div class="submission-heading flex flex-col items-start gap-1.5">
        <h3
          class="submission-title line-clamp-2 min-w-0 font-semibold text-fg transition-colors group-hover:text-accent-text"
          title={name}
        >
          {name}
        </h3>
        <div class="submission-badges flex flex-wrap items-center gap-1.5">
          {
            isPlugin && (
              <span
                class="shrink-0 rounded bg-accent-soft px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent-text"
                title="A Cowork plugin (M365 app package)"
              >
                Plugin
              </span>
            )
          }
          {
            type === "skill" && !isSample && (
              <span class="rounded bg-surface-2 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-muted">
                Skill
              </span>
            )
          }
          {
            isAutomation && (
              <span
                class="shrink-0 rounded bg-accent-soft px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-accent-text"
                title="A Scout automation (scheduled .json)"
              >
                Automation
              </span>
            )
          }
          {
            isSample && (
              <span
                class="shrink-0 rounded bg-amber-400/20 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-600 dark:text-amber-400"
                title="A sample / demo skill — placeholder content"
              >
                Sample
              </span>
            )
          }
        </div>
      </div>
      {
        platforms.length > 0 && (
          <div class="mt-1 flex flex-wrap items-center gap-x-2.5 gap-y-1">
            {platforms.map((platform) => (
              <span class="flex items-center gap-1 text-xs text-muted">
                <span
                  class="h-1.5 w-1.5 rounded-full"
                  style={`background:${PLATFORM_COLORS[platform]}`}
                />
                {platform}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>

  <!-- Description — the tile's focus -->
  <div class="mt-3 flex-1">
    <p class="submission-description text-sm leading-relaxed text-muted line-clamp-3">
      {description}
    </p>
  </div>

  <!-- Footer: tags + rating/download hints -->
  <div
    class="mt-4 flex items-center justify-between gap-2 border-t border-border pt-3"
  >
    <div class="flex min-w-0 flex-wrap items-center gap-1.5">
      {
        shownTags.map((t) => (
          <span class="rounded-full bg-surface-2 px-2 py-0.5 text-[11px] font-medium text-muted">
            {t}
          </span>
        ))
      }
      {
        shownTags.length === 0 && (
          <span class="truncate text-xs text-subtle">
            {author ? `by ${author}` : isPlugin ? "Cowork plugin" : isAutomation ? "Scout automation" : "Community skill"}
          </span>
        )
      }
    </div>
    <span class="flex shrink-0 items-center gap-2.5 text-xs text-subtle">
      {
        hasBundle && (
          <span class="flex items-center gap-1" title={isInstaller ? "Includes a downloadable automation installer" : isAutomation ? "Includes a downloadable automation file" : "Includes a downloadable bundle"}>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="h-3.5 w-3.5"
            >
              <path d="M3 7a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
            </svg>
            {isAutomation && !isInstaller ? ".json" : ".zip"}
          </span>
        )
      }
      {
        rating > 0 && (
          <span
            class="flex items-center gap-1"
            title={`${rating} ${rating === 1 ? "rating" : "ratings"}`}
          >
            <span aria-hidden="true">👍</span>
            {rating}
          </span>
        )
      }
      {
        downloads > 0 && (
          <span
            class="flex items-center gap-1"
            title={`${downloads.toLocaleString("en-US")} ${downloads === 1 ? "download" : "downloads"}`}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-3.5 w-3.5"
              aria-hidden="true"
            >
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" />
            </svg>
            {downloads.toLocaleString("en-US")}
          </span>
        )
      }
    </span>
  </div>
</Wrapper>

<style>
  .submission-card:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .submission-card[data-variant="spotlight"] {
    min-height: 21rem;
    padding: 1.5rem;
    border-radius: 1rem;
    border-color: color-mix(in srgb, var(--border) 65%, var(--surface));
    background: color-mix(in srgb, var(--accent-soft) 20%, var(--surface));
  }
  .submission-card[data-variant="spotlight"]:where(a:hover) {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--surface));
  }
  [data-variant="spotlight"] .submission-monogram {
    width: 3.5rem;
    height: 3.5rem;
    font-size: 1.125rem;
  }
  [data-variant="spotlight"] .submission-title {
    width: 100%;
    font-size: 1.4rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
    -webkit-line-clamp: 3;
  }
  [data-variant="spotlight"] .submission-description {
    font-size: 0.9375rem;
    -webkit-line-clamp: 4;
  }
  @media (prefers-reduced-motion: reduce) {
    .submission-card {
      transition: none;
      transform: none;
    }
  }
</style>
