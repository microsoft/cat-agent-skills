---
import { withBase } from "../lib/url";
import { coverGradient, initials } from "../lib/skills";
import type { Platform, SkillType } from "../lib/skills";

interface Props {
  slug: string;
  name: string;
  description: string;
  platforms?: Platform[];
  type?: SkillType;
  tags?: string[];
  coverColor?: string;
  featured?: boolean;
}

const {
  slug, name, description, platforms = [], type = "skill",
  tags = [], coverColor, featured = false,
} = Astro.props;
const isSample = tags.includes("sample");
const Wrapper = isSample ? "div" : "a";
const wrapperProps = isSample
  ? { "aria-disabled": "true", title: "Sample / demo skill — placeholder content, not accessible" }
  : { href: withBase(`/skills/${slug}`) };
---

<Wrapper
  class:list={[
    "submission-card group flex flex-col rounded-xl border border-border bg-surface p-4",
    isSample
      ? "cursor-not-allowed select-none opacity-55 saturate-50"
      : "transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/40 hover:shadow-md",
  ]}
  {...wrapperProps}
>
  <div class="gallery-heading flex items-start gap-3">
    <div class="relative shrink-0">
      <span
        class="grid h-9 w-9 place-items-center rounded-lg text-xs font-bold text-white shadow-sm"
        style={`background-image:${coverGradient(slug, coverColor)}`}
        aria-hidden="true"
      >{initials(name)}</span>
      {featured && (
        <span
          class="absolute -right-1.5 -top-1.5 grid h-[18px] w-[18px] place-items-center rounded-full bg-white text-amber-500 shadow ring-1 ring-black/5"
          title="Hand-picked featured skill"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-2.5 w-2.5">
            <path d="M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94L12 2.5z" />
          </svg>
        </span>
      )}
    </div>
    <h3 class="submission-title line-clamp-2 min-w-0 font-semibold text-fg transition-colors group-hover:text-accent-text" title={name}>{name}</h3>
  </div>
  <p class="submission-description mt-3 line-clamp-2 text-sm text-muted">{description}</p>
  <div class="submission-meta mt-auto flex items-end justify-between gap-2 pt-4 text-[11px] leading-4 text-muted">
    {isSample && <span>Sample</span>}
    <span class="submission-format-platform ml-auto flex flex-wrap items-center justify-end gap-x-1.5">
      <span class="capitalize">{type}</span>
      {platforms.map((platform) => <><span aria-hidden="true">&middot;</span><span class="whitespace-nowrap">{platform}</span></>)}
    </span>
  </div>
</Wrapper>

<style>
  .submission-card { height: 12rem; }
  .submission-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .gallery-heading { min-height: 2.6rem; }
  .submission-title { font-size: 1rem; line-height: 1.3; overflow-wrap: anywhere; }
  .submission-description { min-height: 2.625rem; line-height: 1.5; overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) {
    .submission-card { transition: none; transform: none; }
  }
</style>
