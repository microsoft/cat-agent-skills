---
import { coverGradient, initials, PLATFORM_COLORS, type Platform, type SkillType } from "../lib/skills";

interface Props {
  slug: string;
  name: string;
  platforms?: Platform[];
  type?: SkillType;
  pluginSkillCount?: number;
  tags?: string[];
  coverColor?: string;
  /** "card" for grid thumbnails, "hero" for the detail header. */
  variant?: "card" | "hero";
  class?: string;
}

const {
  slug,
  name,
  platforms = [],
  type = "skill",
  pluginSkillCount,
  tags = [],
  coverColor,
  variant = "card",
  class: className = "",
} = Astro.props;

const gradient = coverGradient(slug, coverColor);
const mark = initials(name);
const isHero = variant === "hero";
const isSample = tags.includes("sample");
const shownTags = tags.filter((t) => t !== "sample");
const shownPlatforms = isHero ? platforms : platforms.slice(0, 2);
const extraPlatforms = platforms.length - shownPlatforms.length;
---

<div
  class:list={[
    "relative overflow-hidden",
    isHero ? "h-56 sm:h-64" : "aspect-[16/10]",
    isSample && "ring-2 ring-inset ring-amber-400/70",
    className,
  ]}
  style={`background-image:${gradient}`}
>
  <!-- decorative texture -->
  <div
    class="absolute inset-0 opacity-25"
    style="background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,.5) 0, transparent 40%), radial-gradient(circle at 80% 0%, rgba(255,255,255,.35) 0, transparent 35%);"
  >
  </div>
  <div
    class="absolute -right-6 -top-8 select-none font-black text-white/15 leading-none"
    class:list={[isHero ? "text-[12rem]" : "text-[7rem]"]}
  >
    {mark}
  </div>

  <div
    class="relative flex h-full flex-col justify-between p-4"
    class:list={[isHero && "p-6 sm:p-8"]}
  >
    <div class="flex flex-wrap items-center gap-1.5">
      {
        isSample && (
          <span
            class="flex items-center gap-1 rounded-full bg-amber-400 px-2.5 py-1 text-[11px] font-semibold text-neutral-900 shadow-sm"
            title="A sample / demo skill — placeholder content, not a real submission"
          >
            Sample
          </span>
        )
      }
      {
        type === "plugin" && (
          <span class="flex items-center gap-1.5 rounded-full bg-white/20 px-2.5 py-1 text-[11px] font-semibold text-white ring-1 ring-inset ring-white/25 backdrop-blur-sm" title="A Cowork plugin (M365 app package)">
            Plugin{pluginSkillCount !== undefined && ` · ${pluginSkillCount} ${pluginSkillCount === 1 ? "skill" : "skills"}`}
          </span>
        )
      }
      {
        type === "automation" && (
          <span class="flex items-center gap-1.5 rounded-full bg-white/20 px-2.5 py-1 text-[11px] font-semibold text-white ring-1 ring-inset ring-white/25 backdrop-blur-sm" title="A Scout automation (scheduled .json)">
            Automation
          </span>
        )
      }
      {
        shownPlatforms.map((platform) => (
          <span class="flex items-center gap-1.5 rounded-full bg-white/20 px-2.5 py-1 text-[11px] font-semibold text-white ring-1 ring-inset ring-white/25 backdrop-blur-sm">
            <span class="h-2 w-2 rounded-full ring-1 ring-white/80" style={`background:${PLATFORM_COLORS[platform]}`} />
            {platform}
          </span>
        ))
      }
      {
        extraPlatforms > 0 && (
          <span class="flex items-center gap-1.5 rounded-full bg-white/20 px-2.5 py-1 text-[11px] font-semibold text-white ring-1 ring-inset ring-white/25 backdrop-blur-sm">+{extraPlatforms}</span>
        )
      }
    </div>

    <div>
      <h3
        class="font-bold leading-tight text-white drop-shadow-sm"
        class:list={[isHero ? "text-3xl sm:text-4xl" : "text-lg line-clamp-2"]}
      >
        {name}
      </h3>
      {
        shownTags.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-1.5">
            {shownTags.slice(0, isHero ? 8 : 3).map((t) => (
              <span class="rounded-full bg-white/20 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-sm">
                {t}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
