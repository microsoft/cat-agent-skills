---
import { coverGradient, initials, PLATFORM_COLORS, type Platform, type SkillType } from "../lib/skills";

interface Props {
  slug: string;
  name: string;
  platforms?: Platform[];
  type?: SkillType;
  tags?: string[];
  coverColor?: string;
  builtByMicrosoft?: boolean;
  /** "card" for grid thumbnails, "hero" for the detail header. */
  variant?: "card" | "hero";
  class?: string;
}

const {
  slug,
  name,
  platforms = [],
  type = "skill",
  tags = [],
  coverColor,
  builtByMicrosoft = false,
  variant = "card",
  class: className = "",
} = Astro.props;

const gradient = coverGradient(slug, coverColor);
const mark = initials(name);
const isHero = variant === "hero";
const isSample = tags.includes("sample");
const shownTags = tags.filter((t) => t !== "sample");
const shownPlatforms = isHero ? platforms : platforms.slice(0, 2);
const extraPlatforms = platforms.length - shownPlatforms.length;
const chip = "flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1 text-xs font-semibold text-neutral-900 shadow-sm ring-1 ring-inset ring-black/5";
---

<div
  class:list={[
    "relative overflow-hidden",
    isHero ? "h-56 sm:h-64" : "aspect-[16/10]",
    isSample && "ring-2 ring-inset ring-amber-400/70",
    className,
  ]}
  style={`background-image:${gradient}`}
>
  <!-- decorative texture -->
  <div
    class="absolute inset-0 opacity-25"
    style="background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,.5) 0, transparent 40%), radial-gradient(circle at 80% 0%, rgba(255,255,255,.35) 0, transparent 35%);"
  >
  </div>
  <div
    class="absolute -right-6 -top-8 select-none font-black text-white/15 leading-none"
    class:list={[isHero ? "text-[12rem]" : "text-[7rem]"]}
  >
    {mark}
  </div>

  <div
    class="relative flex h-full flex-col justify-between p-4"
    class:list={[isHero && "p-6 sm:p-8"]}
  >
    <div class="flex flex-wrap items-center gap-1.5">
      {
        isSample && (
          <span
            class="flex items-center gap-1 rounded-full bg-amber-400 px-3 py-1 text-xs font-semibold text-neutral-900 shadow-sm"
            title="A sample / demo skill — placeholder content, not a real submission"
          >
            Sample
          </span>
        )
      }
      {
        builtByMicrosoft && (
          <span class={chip} title="Built by Microsoft" aria-label="Built by Microsoft" role="img">
            <svg viewBox="0 0 23 23" class="h-3.5 w-3.5" aria-hidden="true">
              <path fill="#f25022" d="M1 1h10v10H1z" />
              <path fill="#7fba00" d="M12 1h10v10H12z" />
              <path fill="#00a4ef" d="M1 12h10v10H1z" />
              <path fill="#ffb900" d="M12 12h10v10H12z" />
            </svg>
          </span>
        )
      }
      {
        type === "plugin" && (
          <span class={chip} title="A Cowork plugin (M365 app package)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-neutral-500" aria-hidden="true"><path d="m21 8-9-5-9 5v8l9 5 9-5z" /><path d="m3 8 9 5 9-5" /><path d="M12 13v8" /></svg>
            Plugin
          </span>
        )
      }
      {
        type === "automation" && (
          <span class={chip} title="A Scout automation (scheduled .json)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-neutral-500" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            Automation
          </span>
        )
      }
      {
        shownPlatforms.map((platform) => (
          <span class={chip}>
            <span class="h-2 w-2 rounded-full" style={`background:${PLATFORM_COLORS[platform]}`} />
            {platform}
          </span>
        ))
      }
      {extraPlatforms > 0 && <span class={chip}>+{extraPlatforms}</span>}
    </div>

    <div>
      <h3
        class="font-bold leading-tight text-white drop-shadow-sm"
        class:list={[isHero ? "text-3xl sm:text-4xl" : "text-lg line-clamp-2"]}
      >
        {name}
      </h3>
      {
        shownTags.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-1.5">
            {shownTags.slice(0, isHero ? 8 : 3).map((t) => (
              <span class="rounded-full bg-white/20 px-2 py-0.5 text-[10px] font-medium text-white backdrop-blur-sm">
                {t}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
